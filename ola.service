[Unit]
Description=Open Lighting Architecture (OLA) Daemon
After=network.target
# Keep retrying forever, e.g. if the UART is slow to appear
StartLimitIntervalSec=0

[Service]
# Switch on wired (GPIO 17) and wireless (GPIO 27) DMX. "+" runs this as root.
ExecStartPre=+/usr/bin/pinctrl 17,27 op dh
ExecStart=/usr/bin/olad --config-dir /etc/ola -l 3
Restart=always
RestartSec=5
User=olad
Group=olad
SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
